extern GetStdHandle
extern WriteFile
extern ExitProcess

section .rodata
    msg db "Hello World!", 0

msg_len equ $-msg
stdout_query equ -11

section .data
    stdout dw 0
    bytes_written dw 0

section .text

global main

main:
    mov rcx, stdout_query
    call GetStdHandle
    mov [rel stdout], rax

    mov  rcx, [rel stdout]
    mov  rdx, msg
    mov  r8, msg_len
    mov  r9, bytes_written
    mov  dword [rsp - 4], 0
    call WriteFile

    ; mov rcx, 0
    ; mov rdx, msg
    ; mov r8, msg
    ; mov r9, 0
    ; call MessageBoxA

    xor rcx, rcx
    call ExitProcess